{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quinta-escena/archive_item.schema.json",
  "title": "Objeto de archivo",
  "type": "object",
  "required": ["slug", "title", "type", "kind", "provenance", "rights", "description_md", "sources", "verification", "published"],
  "properties": {
    "slug": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "type": { "const": "archive_item" },
    "title": { "type": "string" },
    "kind": { "type": "string", "enum": ["fotografia", "afiche", "programa", "libreto", "video", "entrevista", "documento", "testimonio", "compania-desaparecida", "festival-historico", "espacio-desaparecido", "memoria-oral"] },
    "date_text": { "type": ["string", "null"] },
    "date_start": { "$ref": "_definitions.schema.json#/definitions/date" },
    "date_end": { "$ref": "_definitions.schema.json#/definitions/date" },
    "date_precision": { "type": "string", "enum": ["day", "month", "year", "decade", "unknown"] },
    "author": { "type": ["string", "null"] },
    "provenance": { "type": "string" },
    "communes": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "rights": { "type": "string" },
    "description_md": { "type": "string" },
    "related": { "type": "array", "items": { "type": "object", "required": ["type", "slug"], "properties": { "type": { "type": "string" }, "slug": { "$ref": "_definitions.schema.json#/definitions/slug" } } } },
    "media": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/media_ref" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } },
    "verification": { "$ref": "_definitions.schema.json#/definitions/verification" },
    "published": { "type": "boolean" }
  }
}
