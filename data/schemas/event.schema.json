{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quinta-escena/event.schema.json",
  "title": "Evento / actividad de cartelera",
  "type": "object",
  "required": ["slug", "title", "type", "kind", "occurrences", "sources", "last_checked_at", "verification", "published"],
  "properties": {
    "slug": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "type": { "const": "event" },
    "title": { "type": "string" },
    "kind": { "type": "string", "enum": ["funcion", "temporada", "festival", "taller", "encuentro", "otro"] },
    "work": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
    "company": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
    "organizer_text": { "type": ["string", "null"] },
    "disciplines": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "audience": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
    "description_md": { "type": ["string", "null"] },
    "price": { "type": ["string", "null"] },
    "is_free": { "type": ["boolean", "null"] },
    "booking_url": { "$ref": "_definitions.schema.json#/definitions/url" },
    "accessibility": { "type": "array", "items": { "type": "string" } },
    "occurrences": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["starts_at"], "properties": {
      "starts_at": { "$ref": "_definitions.schema.json#/definitions/datetime" },
      "ends_at": { "$ref": "_definitions.schema.json#/definitions/datetime" },
      "time_unknown": { "type": "boolean" },
      "venue": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
      "place": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/place" } ] },
      "price": { "type": ["string", "null"] }, "note": { "type": ["string", "null"] } } } },
    "last_checked_at": { "$ref": "_definitions.schema.json#/definitions/date" },
    "media": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/media_ref" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } },
    "verification": { "$ref": "_definitions.schema.json#/definitions/verification" },
    "published": { "type": "boolean" }
  }
}
