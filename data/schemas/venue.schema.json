{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "escena-valparaiso/venue.schema.json",
  "title": "Espacio escénico",
  "type": "object",
  "required": ["slug", "name", "type", "venue_type", "place", "status", "sources", "verification", "published"],
  "properties": {
    "slug": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "type": { "const": "venue" },
    "name": { "type": "string" },
    "short_name": { "type": ["string", "null"] },
    "venue_type": { "type": "string", "enum": ["teatro", "centro-cultural", "sala", "espacio-independiente", "escuela", "museo", "espacio-publico", "no-convencional"] },
    "owner": { "type": ["string", "null"] },
    "place": { "$ref": "_definitions.schema.json#/definitions/place" },
    "capacity": { "type": ["integer", "null"] },
    "rooms": { "type": "array", "items": { "type": "string" } },
    "website": { "$ref": "_definitions.schema.json#/definitions/url" },
    "contact_public": { "type": ["string", "null"] },
    "social": { "$ref": "_definitions.schema.json#/definitions/social" },
    "disciplines": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "accessibility": { "type": "array", "items": { "type": "string" } },
    "program_url": { "$ref": "_definitions.schema.json#/definitions/url" },
    "status": { "type": "string", "enum": ["activo", "cerrado-temporal", "desaparecido", "desconocido"] },
    "description_md": { "type": ["string", "null"] },
    "media": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/media_ref" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } },
    "verification": { "$ref": "_definitions.schema.json#/definitions/verification" },
    "published": { "type": "boolean" }
  }
}
