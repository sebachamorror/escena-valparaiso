{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "escena-valparaiso/episode.schema.json",
  "title": "Episodio de una serie",
  "type": "object",
  "required": ["slug", "type", "series", "number", "title", "commune", "province", "discipline", "status", "sources"],
  "properties": {
    "slug": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "type": { "const": "episode" },
    "series": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string" },
    "title_provisional": { "type": "boolean" },
    "tramo": { "type": ["string", "null"] },
    "commune": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "province": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "protagonist_artist": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
    "protagonist_company": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
    "discipline": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "narrative_axis": { "type": ["string", "null"] },
    "natural_location": { "type": ["string", "null"] },
    "natural_location_place": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/place" } ] },
    "work_location_text": { "type": ["string", "null"] },
    "synopsis_md": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["planificado", "grabado", "en-edicion", "publicado"] },
    "video_url": { "$ref": "_definitions.schema.json#/definitions/url" },
    "audio_url": { "$ref": "_definitions.schema.json#/definitions/url" },
    "duration_min": { "type": ["integer", "null"] },
    "has_subtitles": { "type": ["boolean", "null"] },
    "has_sign_language": { "type": ["boolean", "null"] },
    "transcript_md": { "type": ["string", "null"] },
    "capsules": { "type": "array", "items": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" }, "url": { "$ref": "_definitions.schema.json#/definitions/url" }, "platform": { "type": ["string", "null"] } } } },
    "objects": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "description_md": { "type": ["string", "null"] }, "given_by": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] } } } },
    "media": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/media_ref" } },
    "related": { "type": "array", "items": { "type": "object", "required": ["type", "slug"], "properties": { "type": { "type": "string" }, "slug": { "$ref": "_definitions.schema.json#/definitions/slug" } } } },
    "published_at": { "$ref": "_definitions.schema.json#/definitions/date" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } }
  }
}
