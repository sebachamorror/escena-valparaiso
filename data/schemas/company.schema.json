{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "escena-valparaiso/company.schema.json",
  "title": "Compañía",
  "type": "object",
  "required": ["slug", "name", "type", "commune", "disciplines", "status", "sources", "verification", "published"],
  "properties": {
    "slug": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "type": { "const": "company" },
    "name": { "type": "string", "minLength": 2 },
    "legal_name": { "type": ["string", "null"] },
    "description_md": { "type": ["string", "null"] },
    "commune": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "other_communes": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "disciplines": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "audiences": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "founded_year": { "$ref": "_definitions.schema.json#/definitions/year" },
    "status": { "type": "string", "enum": ["activa", "inactiva", "desaparecida", "desconocido"] },
    "last_activity_at": { "$ref": "_definitions.schema.json#/definitions/date" },
    "members": { "type": "array", "items": { "type": "object", "required": ["artist", "role"], "properties": {
      "artist": { "$ref": "_definitions.schema.json#/definitions/slug" }, "role": { "type": "string" },
      "from_year": { "$ref": "_definitions.schema.json#/definitions/year" }, "to_year": { "$ref": "_definitions.schema.json#/definitions/year" } } } },
    "members_text": { "type": "array", "items": { "type": "string" } },
    "works": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "venues": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "place": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/place" } ] },
    "email": { "type": ["string", "null"] },
    "contact_authorized": { "type": "boolean" },
    "website": { "$ref": "_definitions.schema.json#/definitions/url" },
    "social": { "$ref": "_definitions.schema.json#/definitions/social" },
    "trajectory_md": { "type": ["string", "null"] },
    "recognitions": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/recognition" } },
    "funding_awards": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/funding_award" } },
    "festivals": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/festival_participation" } },
    "media": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/media_ref" } },
    "media_candidates": { "type": "array", "items": { "type": "object" } },
    "series": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } },
    "verification": { "$ref": "_definitions.schema.json#/definitions/verification" },
    "published": { "type": "boolean" }
  }
}
