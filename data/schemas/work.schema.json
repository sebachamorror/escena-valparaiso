{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quinta-escena/work.schema.json",
  "title": "Obra",
  "type": "object",
  "required": ["slug", "title", "type", "disciplines", "sources", "verification", "published"],
  "properties": {
    "slug": { "$ref": "_definitions.schema.json#/definitions/slug" },
    "type": { "const": "work" },
    "title": { "type": "string", "minLength": 1 },
    "authorship": { "type": ["string", "null"] },
    "direction": { "type": ["string", "null"] },
    "companies": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "credits": { "type": "array", "items": { "type": "object", "required": ["role"], "properties": {
      "artist": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] }, "name": { "type": ["string", "null"] }, "role": { "type": "string" } } } },
    "disciplines": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "audience": { "anyOf": [ { "type": "null" }, { "$ref": "_definitions.schema.json#/definitions/slug" } ] },
    "duration_min": { "type": ["integer", "null"] },
    "premiere_year": { "$ref": "_definitions.schema.json#/definitions/year" },
    "synopsis_md": { "type": ["string", "null"] },
    "communes": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "video_url": { "$ref": "_definitions.schema.json#/definitions/url" },
    "dossier_url": { "$ref": "_definitions.schema.json#/definitions/url" },
    "venues": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/slug" } },
    "history_text": { "type": "array", "items": { "type": "string" } },
    "media": { "type": "array", "items": { "$ref": "_definitions.schema.json#/definitions/media_ref" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } },
    "verification": { "$ref": "_definitions.schema.json#/definitions/verification" },
    "published": { "type": "boolean" }
  }
}
