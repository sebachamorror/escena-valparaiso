{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "escena-valparaiso/_definitions.schema.json",
  "title": "Definiciones compartidas",
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "datetime": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?([+-][0-9]{2}:[0-9]{2}|Z)$" },
    "url": { "type": ["string", "null"], "pattern": "^https?://" },
    "year": { "type": ["integer", "null"], "minimum": 1800, "maximum": 2100 },
    "source": {
      "type": "object",
      "required": ["title", "publisher", "type", "level", "accessed_at"],
      "properties": {
        "url": { "$ref": "#/definitions/url" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["oficial", "institucional", "prensa", "academico", "red-social", "directorio", "testimonio", "documento-proyecto", "otro"] },
        "level": { "type": "integer", "enum": [1, 2, 3] },
        "role": { "type": "string", "enum": ["primaria", "secundaria"] },
        "accessed_at": { "$ref": "#/definitions/date" },
        "archived_url": { "$ref": "#/definitions/url" },
        "supports": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "confidence_score"],
      "properties": {
        "status": { "type": "string", "enum": ["pendiente", "verificado", "requiere_actualizacion", "rechazado"] },
        "confidence_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "verified_at": { "$ref": "#/definitions/date" },
        "verified_by": { "type": ["string", "null"] },
        "next_review_at": { "$ref": "#/definitions/date" },
        "note": { "type": ["string", "null"] }
      }
    },
    "social": {
      "type": "object",
      "properties": {
        "instagram": { "$ref": "#/definitions/url" },
        "facebook": { "$ref": "#/definitions/url" },
        "tiktok": { "$ref": "#/definitions/url" },
        "youtube": { "$ref": "#/definitions/url" }
      }
    },
    "media_ref": {
      "type": "object",
      "required": ["kind", "title", "author", "license", "credit"],
      "properties": {
        "kind": { "type": "string", "enum": ["image", "video", "audio", "document"] },
        "url": { "$ref": "#/definitions/url" },
        "storage_path": { "type": ["string", "null"] },
        "title": { "type": "string" },
        "alt_text": { "type": ["string", "null"] },
        "author": { "type": "string" },
        "credit": { "type": "string" },
        "license": { "type": "string" },
        "source_url": { "$ref": "#/definitions/url" },
        "taken_at": { "$ref": "#/definitions/date" },
        "consent_note": { "type": ["string", "null"] },
        "role": { "type": "string", "enum": ["cover", "gallery", "portrait", "poster", "still"] }
      }
    },
    "place": {
      "type": "object",
      "required": ["commune", "precision"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "commune": { "$ref": "#/definitions/slug" },
        "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "precision": { "type": "string", "enum": ["exact", "street", "commune_centroid", "unknown"] },
        "geocode_source": { "type": ["string", "null"] },
        "geocoded_at": { "$ref": "#/definitions/date" }
      }
    },
    "recognition": {
      "type": "object",
      "required": ["title", "org", "year"],
      "properties": {
        "title": { "type": "string" }, "org": { "type": "string" }, "year": { "$ref": "#/definitions/year" },
        "url": { "$ref": "#/definitions/url" }, "source_index": { "type": ["integer", "null"] }
      }
    },
    "funding_award": {
      "type": "object",
      "required": ["fund_name", "org", "year"],
      "properties": {
        "fund_name": { "type": "string" }, "org": { "type": "string" }, "year": { "$ref": "#/definitions/year" },
        "folio": { "type": ["string", "null"] }, "amount_clp": { "type": ["integer", "null"] },
        "url": { "$ref": "#/definitions/url" }, "note": { "type": ["string", "null"] }, "source_index": { "type": ["integer", "null"] }
      }
    },
    "festival_participation": {
      "type": "object",
      "required": ["festival_name", "year"],
      "properties": {
        "festival_name": { "type": "string" }, "year": { "$ref": "#/definitions/year" },
        "place": { "type": ["string", "null"] }, "source_index": { "type": ["integer", "null"] }
      }
    }
  }
}
