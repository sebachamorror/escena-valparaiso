{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "escena-valparaiso/territory.schema.json",
  "title": "Archivo de territorios (región, provincias, comunas)",
  "type": "object",
  "required": ["region", "provinces", "communes", "sources"],
  "properties": {
    "region": { "type": "object", "required": ["slug", "name", "country_code"], "properties": {
      "slug": { "$ref": "_definitions.schema.json#/definitions/slug" }, "name": { "type": "string" }, "country_code": { "type": "string" }, "cut_code": { "type": ["string", "null"] } } },
    "provinces": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["slug", "name", "region"], "properties": {
      "slug": { "$ref": "_definitions.schema.json#/definitions/slug" }, "name": { "type": "string" }, "region": { "$ref": "_definitions.schema.json#/definitions/slug" },
      "cut_code": { "type": ["string", "null"] }, "sort": { "type": "integer" }, "capital": { "type": ["string", "null"] }, "insular": { "type": "boolean" } } } },
    "communes": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["slug", "name", "province"], "properties": {
      "slug": { "$ref": "_definitions.schema.json#/definitions/slug" }, "name": { "type": "string" }, "province": { "$ref": "_definitions.schema.json#/definitions/slug" },
      "cut_code": { "type": ["string", "null"] }, "insular": { "type": "boolean" },
      "lat": { "type": ["number", "null"] }, "lng": { "type": ["number", "null"] }, "centroid_source": { "type": ["string", "null"] } } } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "_definitions.schema.json#/definitions/source" } },
    "verification": { "$ref": "_definitions.schema.json#/definitions/verification" }
  }
}
