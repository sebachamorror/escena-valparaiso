# ESCENA VALPARAÍSO — variables de entorno
# Copiar a .env.local. Nunca versionar .env.local.

# Modo previsualización de equipo: muestra fichas en estado "pendiente"
# con etiqueta "en verificación" y noindex. En desarrollo está activo
# por defecto; en producción debe fijarse explícitamente.
# ESCENA_PREVIEW=1

# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Fase 3). Sin estas variables la app funciona solo con data/.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Analítica sin cookies (Plausible). Si falta, no se carga ningún script.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
